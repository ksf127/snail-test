<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.company</groupId>
        <artifactId>arch-learning</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>phase3-shortlink-service</artifactId>
    <name>phase3-shortlink-service</name>
    <description>阶段三之一：百万 QPS 短链 —— 号段发号 + Base62 + 布隆 + L1/L2 + 单飞回源 + 302</description>

    <dependencies>
        <!-- 缓存出口、Redis 号段/布隆/点击计数都通过 Starter 访问，业务层看不到客户端 -->
        <dependency>
            <groupId>com.company</groupId>
            <artifactId>company-redis-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.company</groupId>
            <artifactId>company-lock-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.company</groupId>
            <artifactId>company-threadpool-starter</artifactId>
        </dependency>
        <!-- L1 本地缓存，版本由 spring-boot-dependencies 管理 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
