<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      三阶段学习工程，按阶段拆成可独立启动的服务：

        第一阶段 phase1-service            多线程 + 设计模式
        第二阶段 phase2-service            缓存 + 中间件 + 分布式锁
        第三阶段 phase3-shortlink-service  百万 QPS 短链
                 phase3-mall-service       商城 + 分布式事务

      刻意不继承 company-services：这里不接 Nacos 注册/配置，也不做链路追踪，
      每个模块 mvn spring-boot:run 就能单独跑（端口 8201~8204），
      需要 Redis / RabbitMQ 时改 application.yml 里对应的开关即可。
    -->
    <parent>
        <groupId>com.company</groupId>
        <artifactId>company-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../company-parent/pom.xml</relativePath>
    </parent>

    <artifactId>arch-learning</artifactId>
    <packaging>pom</packaging>
    <name>arch-learning</name>

    <modules>
        <module>phase1-service</module>
        <module>phase2-service</module>
        <module>phase3-shortlink-service</module>
        <module>phase3-mall-service</module>
        <!-- 基准测试不继承本模块的 Web 依赖，parent 直接指向 company-parent -->
        <module>arch-learning-benchmark</module>
    </modules>

    <!--
      四个服务共享的最小集合：Web、校验、可观测性、测试。
      不放 Nacos / LoadBalancer / Tracing，保证纯本地独立启动。
    -->
    <dependencies>
        <dependency>
            <groupId>com.company</groupId>
            <artifactId>company-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 与 company-services 保持同一套依赖红线：只能通过 company-*-starter 访问中间件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-direct-middleware-deps</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework.boot:spring-boot-starter-data-redis</exclude>
                                        <exclude>redis.clients:jedis</exclude>
                                        <exclude>com.mysql:mysql-connector-j</exclude>
                                        <exclude>com.baomidou:mybatis-plus-spring-boot3-starter</exclude>
                                    </excludes>
                                    <message>业务服务只能通过 company-*-starter 访问中间件，禁止直接引入客户端/驱动。</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
